<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="sop-post-launch-eval" name="SOP Post-Launch Evaluation">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="FLOW SOP POST-LAUNCH EVALUATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D71920;fontColor=#D71920;fontStyle=1;fontSize=15;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="0" y="14" width="1300" height="38" as="geometry" />
        </mxCell>

        <!-- ================= MAIN FLOW (center x=625) ================= -->
        <mxCell id="n1" value="MULAI" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="63" width="130" height="30" as="geometry" /></mxCell>
        <mxCell id="n2" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER / RnD SUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menerima Product Release Authorization, Operational Handover Record, monitoring plan, baseline, dan open condition" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="455" y="114" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n3" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER + FUNCTIONAL OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Meregistrasikan evaluasi dan mengonfirmasi monitoring window, parameter, baseline, data source, frequency, owner, evidence, serta escalation criteria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="455" y="189" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n4" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;FUNCTIONAL OWNER + RnD SUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mengumpulkan data production, quality, customer, commercial, supply, cost, dan open action serta menjaga traceability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="455" y="264" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n5" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + SUPPORT + DATA OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memvalidasi completeness, accuracy, source, period, version, duplicate, missing data, dan konsistensi antar sumber" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="455" y="339" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n6" value="Apakah dataset lengkap, valid, dan dapat ditelusuri?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="418" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="n7" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;TECHNICAL + FORMULATION + QA/QC + FUNCTIONAL OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Membandingkan actual performance dengan baseline, specification, release target, forecast, prior batch, dan trend selama monitoring window" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="455" y="504" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n8" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;QA/QC + RnD MANAGER + PROCESS OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menilai food safety, legal/regulatory, critical quality, customer safety, supply continuity, dan kebutuhan immediate containment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="455" y="579" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n9" value="Apakah terdapat critical issue?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="658" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="n10" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + TIM EVALUASI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cross-functional evaluation atas stabilitas produk/proses, complaint/return, yield/capacity, supply, customer response, commercial result, cost variance, open condition, dan action effectiveness" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="455" y="744" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n11" value="Apakah terdapat adverse trend, gap, atau open condition?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="823" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="n12" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD MANAGER + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Post-Launch Evaluation Meeting untuk meninjau dataset, trend, issue, action effectiveness, remaining risk, open condition, monitoring transfer, dan closure readiness" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="455" y="1001" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n13" value="Apakah evidence cukup dan performa telah stabil?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="1080" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="n14" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER + TIM EVALUASI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menyelesaikan Post-Launch Evaluation Report: scope, data period, baseline, result, trend, issue, action, residual risk, conclusion, dan next-process reference" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="455" y="1166" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n15" value="Apakah closure criteria terpenuhi dan monitoring transfer dapat dilakukan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="1245" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="n16" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + OPERATIONAL OWNER + SUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menandatangani Project Closure &amp;amp; Monitoring Transfer Record, mengalihkan routine monitoring, complaint/escalation route, remaining responsibility, dan mengarsipkan project package" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="455" y="1331" width="340" height="53" as="geometry" /></mxCell>
        <mxCell id="n17" value="SELESAI — PROJECT CLOSED &amp; ROUTINE MONITORING DIALIHKAN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="1411" width="310" height="34" as="geometry" /></mxCell>

        <!-- ============ CABANG DATASET (kanan, x=1050) ============ -->
        <mxCell id="n18" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + DATA OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mengklarifikasi data gap, merekonsiliasi source of truth, period, unit, version, dan meminta evidence tambahan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="940" y="421" width="220" height="53" as="geometry" /></mxCell>
        <mxCell id="n19" value="Apakah data dapat dilengkapi dan direkonsiliasi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="965" y="501" width="170" height="53" as="geometry" /></mxCell>
        <mxCell id="n20" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + RnD MANAGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memperbarui Extended Monitoring Plan, observation window, data requirement, owner, dan review reference" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="581" width="220" height="53" as="geometry" /></mxCell>
        <mxCell id="n21" value="SELESAI — EXTENDED MONITORING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="933" y="660" width="235" height="31" as="geometry" /></mxCell>

        <!-- ============ CABANG CRITICAL ISSUE (kiri, x=200) ============ -->
        <mxCell id="n22" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;QA/QC + RnD MANAGER + PROCESS OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Immediate containment, mengamankan produk/material, menilai impact, dan melakukan eskalasi sesuai authority" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="90" y="661" width="220" height="53" as="geometry" /></mxCell>
        <mxCell id="n23" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;QA/QC + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Membuka dan menyerahkan issue ke Complaint, CAPA, Recall/Withdrawal, Quality Incident, atau proses lain yang berlaku" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="741" width="220" height="53" as="geometry" /></mxCell>
        <mxCell id="n24" value="SELESAI — DIALIHKAN KE CRITICAL ISSUE PROCESS" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="820" width="240" height="31" as="geometry" /></mxCell>

