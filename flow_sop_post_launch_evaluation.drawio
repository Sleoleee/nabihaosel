        <mxCell id="n27" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Membuat Product Change Request dan menyerahkan evidence serta impact assessment" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1095" y="986" width="150" height="53" as="geometry" /></mxCell>
