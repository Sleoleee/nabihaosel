        <mxCell id="n25" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;ACTION OWNER + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Root cause analysis dan menetapkan action, owner, evidence, dependency, escalation, serta routing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="865" y="826" width="220" height="53" as="geometry" /></mxCell>
