        <mxCell id="n29" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;ACTION OWNER + FUNCTIONAL OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Melaksanakan local correction atau preventive action dan mengumpulkan evidence effectiveness" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="865" y="986" width="220" height="53" as="geometry" /></mxCell>
