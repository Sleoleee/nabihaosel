          <mxGeometry x="380" y="80" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="B" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;R&amp;amp;D + MARKETING / REQUEST OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Launch / Change Sounding&lt;/b&gt;&lt;br&gt;Menyelaraskan rencana launch produk baru atau perubahan produk existing dan mendefinisikan kebutuhan packaging artwork (AW)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="174" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="C" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;R&amp;amp;D&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Packaging Brief &amp;amp; Material Handover&lt;/b&gt;&lt;br&gt;Menyerahkan Packaging Brief: spesifikasi produk, jenis/ukuran kemasan, dieline, konten label wajib, klaim disetujui, timeline, dan material sumber." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="296" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="D" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;MARKETING COORDINATOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Register &amp;amp; Completeness Review&lt;/b&gt;&lt;br&gt;Meregistrasi request AW dan memastikan brief, spesifikasi, dieline, konten label, klaim, brand asset, dan dependency tersedia." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="418" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="E" value="Apakah brief dan material lengkap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="I" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;GRAPHIC &amp;amp; VIDEO DESIGNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Artwork Design Production&lt;/b&gt;&lt;br&gt;Membuat desain packaging AW sesuai dieline dan brief: layout, grafis, penempatan konten label, klaim, barcode, dan identitas brand BigFarm / Kansas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="680" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="J" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;DESIGNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Internal Quality Check&lt;/b&gt;&lt;br&gt;Memastikan dieline, ukuran, resolusi, warna, brand guideline, dan kelengkapan elemen kemasan terpenuhi." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="802" width="240" height="72" as="geometry" />
        </mxCell>
