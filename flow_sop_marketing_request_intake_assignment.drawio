  <diagram id="sop-marketing-request-intake" name="SOP Marketing Request Intake &amp; Assignment">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="2580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="FLOW SOP MARKETING REQUEST INTAKE &amp; ASSIGNMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D71920;fontColor=#D71920;fontStyle=1;fontSize=15;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="0" y="16" width="1020" height="38" as="geometry" />
        </mxCell>

        <!-- ================= MAIN SPINE (center x=500) ================= -->
        <mxCell id="A" value="MULAI" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="B" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;REQUESTER / REQUESTING FUNCTION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Request Need Identified&lt;/b&gt;&lt;br&gt;Requester menentukan kebutuhan Marketing dan tujuan penggunaannya." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="174" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="C" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;REQUESTER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Submit Marketing Request Form&lt;/b&gt;&lt;br&gt;Mengisi satu pintu request dengan objective, brand/SKU, deliverable, channel/specification, due date, attachment, dan reference terkait." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="296" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="D" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;MARKETING COORDINATOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Register &amp;amp; Acknowledge&lt;/b&gt;&lt;br&gt;Mencatat request, memberikan Request ID/status, dan memastikan request dapat ditelusuri." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="418" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="E" value="Apakah request lengkap dan jelas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="I" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;MARKETING COORDINATOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Scope &amp;amp; Request Classification&lt;/b&gt;&lt;br&gt;Klasifikasikan: design/content, booth/event, packaging artwork, banner/brochure, video, company profile, merchandise, atau kebutuhan lain." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="680" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="J" value="Apakah kebutuhan berada dalam scope Marketing?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="802" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="M" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;MARKETING COORDINATOR + RELEVANT OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Calendar, Priority &amp;amp; Capacity Review&lt;/b&gt;&lt;br&gt;Cek kebutuhan terhadap Marketing Plan/calendar, urgency, impact bisnis, deadline, dependency, dan kapasitas tim." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="942" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="N" value="Ada conflict prioritas / kebutuhan approval tambahan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontStyle=1;" vertex="1" parent="1">
