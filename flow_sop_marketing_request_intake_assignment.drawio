        </mxCell>
        <mxCell id="P" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;MARKETING COORDINATOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Accept Request &amp;amp; Prepare Assignment&lt;/b&gt;&lt;br&gt;Tetapkan priority, owner/PIC, target completion, route SOP, dan assignment reference." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="1204" width="240" height="72" as="geometry" />
