  <diagram id="sop-rnd-governance" name="SOP R&amp;D Project Governance">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="FLOW SOP R&amp;amp;D PROJECT GOVERNANCE, PRIORITIZATION &amp;amp; REPORTING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D71920;fontColor=#D71920;fontStyle=1;fontSize=14;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="0" y="12" width="1320" height="36" as="geometry" />
        </mxCell>

        <!-- ================= MAIN FLOW (center x=675) ================= -->
        <mxCell id="n1" value="MULAI" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="617" y="56" width="117" height="27" as="geometry" /></mxCell>
        <mxCell id="n2" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER + RnD SUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mengumpulkan request/proyek baru dan status proyek aktif, milestone, resource, risk, issue, dependency, serta decision need" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="513" y="105" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n3" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + PROJECT OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memverifikasi Project ID, owner, scope, stage, target, evidence, status, resource, risk, dan kemutakhiran data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="513" y="172" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n4" value="Apakah data portfolio lengkap dan mutakhir?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="581" y="243" width="189" height="54" as="geometry" /></mxCell>
        <mxCell id="n5" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + REVIEWERS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menilai strategic fit, customer/market value, quality/regulatory urgency, financial impact, complexity, resource, dependency, dan timing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="513" y="321" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n6" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + RnD MANAGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menyusun Prioritization Scorecard, sequencing, priority class, milestone target, resource proposal, serta hold/cancel dan escalation recommendation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="513" y="388" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n7" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD MANAGER + GOVERNANCE FORUM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Governance Meeting untuk meninjau proyek baru/aktif, score, resource, risk, issue, dependency, variance, dan decision request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="513" y="456" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n8" value="Apakah proyek disetujui untuk dilanjutkan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="581" y="527" width="189" height="54" as="geometry" /></mxCell>
        <mxCell id="n9" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD MANAGER / AUTHORIZED APPROVER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menetapkan priority, sequencing, resource, owner, milestone, condition, dan escalation sesuai keputusan governance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="513" y="604" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n10" value="Apakah resource tersedia dan conflict telah diselesaikan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="581" y="675" width="189" height="54" as="geometry" /></mxCell>
        <mxCell id="n11" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + RnD SUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memperbarui Portfolio Register, dashboard, milestone, risk/issue log, action, resource allocation, status, dan communication" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="513" y="753" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n12" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Project owner menjalankan SOP terkait dan melaporkan progress, evidence, variance, risk, forecast, serta support need" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="513" y="820" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n13" value="Apakah terdapat material variance, critical issue, atau decision need?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="581" y="891" width="189" height="54" as="geometry" /></mxCell>
        <mxCell id="n14" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menyusun Periodic R&amp;amp;D Portfolio Report: progress, completed milestone, risk, bottleneck, resource, decision, dan forecast" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="513" y="969" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n15" value="Apakah proyek siap untuk closure review?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="581" y="1040" width="189" height="54" as="geometry" /></mxCell>
        <mxCell id="n16" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + RnD MANAGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memverifikasi deliverable, acceptance, handover, open action, learning, benefit, monitoring transfer, record, dan closure authority" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="513" y="1117" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n17" value="Apakah seluruh closure requirement terpenuhi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="581" y="1188" width="189" height="54" as="geometry" /></mxCell>
        <mxCell id="n18" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + RnD SUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menutup Project ID, memperbarui Portfolio Register, mengalihkan remaining monitoring, dan mengarsipkan evidence serta learning" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="513" y="1266" width="324" height="47" as="geometry" /></mxCell>
        <mxCell id="n19" value="SELESAI — PROJECT CLOSED &amp; PORTFOLIO UPDATED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="536" y="1337" width="279" height="31" as="geometry" /></mxCell>

        <!-- ============ CABANG A: DATA PORTFOLIO BELUM LENGKAP (kiri, x=207) ============ -->
        <mxCell id="n20" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + PROJECT OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menerbitkan data-gap list, menahan pembahasan final, dan meminta project owner memperbarui evidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="99" y="246" width="216" height="47" as="geometry" /></mxCell>
        <mxCell id="n21" value="Apakah data gap dapat diselesaikan dalam cycle ini?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="128" y="321" width="158" height="47" as="geometry" /></mxCell>
        <mxCell id="n22" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mencatat outstanding data, owner, dampak, dan review reference; status pembahasan ditetapkan On Hold" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="99" y="395" width="216" height="47" as="geometry" /></mxCell>
        <mxCell id="n23" value="SELESAI — MENUNGGU PEMBARUAN DATA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="99" y="468" width="216" height="28" as="geometry" /></mxCell>

        <!-- ============ CABANG: PROYEK TIDAK DISETUJUI (kiri) ============ -->
        <mxCell id="n24" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mencatat keputusan Reject, On Hold, Cancel, atau Return beserta alasan, condition, owner, dan review reference" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="99" y="530" width="216" height="47" as="geometry" /></mxCell>
