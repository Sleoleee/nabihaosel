        <mxCell id="C" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;SOCIAL MEDIA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Review Brief Completeness&lt;/b&gt;&lt;br&gt;Memastikan objective, brand, SKU, target audience, channel, deadline, reference, dan supporting material tersedia." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
