        <mxCell id="I" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;DESIGNER / CREATIVE TEAM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Creative Production&lt;/b&gt;&lt;br&gt;Membuat visual, banner, poster, video, feed, reels, TikTok asset, brosur, atau materi lain sesuai creative brief." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
