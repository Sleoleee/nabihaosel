        <mxCell id="H" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;SOCIAL MEDIA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Create Creative Brief&lt;/b&gt;&lt;br&gt;Menyusun creative brief: objective komunikasi, key message, tone of voice, format asset, dan requirement channel." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;" vertex="1" parent="1">
