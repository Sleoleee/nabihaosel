<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="sop-release-handover" name="SOP Product Release &amp; Handover">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="FLOW SOP PRODUCT RELEASE &amp; HANDOVER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D71920;fontColor=#D71920;fontStyle=1;fontSize=15;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="0" y="14" width="1260" height="38" as="geometry" />
        </mxCell>

        <!-- ================= MAIN FLOW (center x=500) ================= -->
        <mxCell id="n1" value="MULAI" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="438" y="63" width="125" height="30" as="geometry" /></mxCell>
        <mxCell id="n2" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER / RnD SUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menerima effective technical data package, approved trial evidence, release scope, dan proposed effective date" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="114" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n3" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Meregistrasikan release package serta menetapkan checklist, acceptance owner, reviewer, approver, dependency, dan handover recipient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="335" y="186" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n4" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;TECHNICAL + FORMULATION + QA/QC + SUPPORT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memverifikasi controlled formula/BOM, specification, process instruction, test method, quality plan, packaging data, master data, approval, dan traceability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="335" y="259" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n5" value="Apakah technical package valid dan lengkap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="335" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="n6" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + OPERATIONAL FUNCTIONS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Operational readiness review atas process, capacity, resource, material, packaging, equipment, storage, supply, master data, dan system readiness" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="335" y="421" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n7" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;COMMERCIAL + QA + REGULATORY + FINANCE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memverifikasi customer approval, claim/label, regulatory, cost reference, forecast, delivery/launch timing, communication, dan contingency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="335" y="494" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n8" value="Apakah seluruh readiness requirement terpenuhi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="570" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="n9" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;DOCUMENT CONTROL + PROCESS OWNER + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mendistribusikan controlled copy serta menyelesaikan briefing/training, competency check, master-data activation, dan acknowledgement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="335" y="656" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n10" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD MANAGER + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Release Readiness Meeting untuk meninjau checklist, evidence, residual risk, open action, effective date, contingency, monitoring, dan ownership" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="335" y="729" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n11" value="Apakah release direkomendasikan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="805" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="n12" value="Apakah terdapat non-critical open action?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="885" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="n13" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;AUTHORIZED APPROVER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menerbitkan Product Release Authorization dengan scope, effective date, controlled reference, authorized use, approver, dan operational owner" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="974" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n14" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menyerahkan controlled package kepada Production, QA, PPIC, Purchasing, Warehouse/Logistics, Commercial, dan fungsi pengguna" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="335" y="1046" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n15" value="Apakah operational owner menerima handover?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="1123" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="n16" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + OPERATIONAL OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menandatangani Operational Handover Record dan mengalihkan baseline, monitoring plan, open condition, serta escalation route" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="1209" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n17" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD SUPPORT + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mengarsipkan release package dan menyerahkan monitoring ke SOP Post-Launch Evaluation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="335" y="1281" width="330" height="53" as="geometry" /></mxCell>
        <mxCell id="n18" value="SELESAI — PRODUK RELEASED &amp; HANDOVER DITERIMA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="358" y="1356" width="285" height="34" as="geometry" /></mxCell>

        <!-- ============ CABANG A: TECHNICAL PACKAGE BELUM VALID (x=150) ============ -->
        <mxCell id="n19" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + PACKAGE OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menerbitkan gap list dan meminta koreksi dokumen, approval, version, traceability, atau master data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="45" y="421" width="210" height="53" as="geometry" /></mxCell>
        <mxCell id="n20" value="Apakah gap dapat diselesaikan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="504" width="160" height="53" as="geometry" /></mxCell>
        <mxCell id="n21" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Membuat Return Record dan mengembalikan package ke Product Documentation, Trial, Development, atau Change Control" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="586" width="210" height="53" as="geometry" /></mxCell>
        <mxCell id="n22" value="SELESAI — PACKAGE DIKEMBALIKAN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="43" y="667" width="215" height="31" as="geometry" /></mxCell>

        <!-- ============ CABANG C: RELEASE TIDAK DIREKOMENDASIKAN (x=150) ============ -->
        <mxCell id="n23" value="Apakah perlu revisi atau penutupan gap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="809" width="160" height="53" as="geometry" /></mxCell>
        <mxCell id="n24" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD MANAGER / AUTHORIZED APPROVER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menahan atau menolak release dan mencatat alasan, dampak, serta keputusan approver" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="45" y="889" width="210" height="53" as="geometry" /></mxCell>
        <mxCell id="n25" value="SELESAI — RELEASE TIDAK DISETUJUI" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="43" y="970" width="215" height="31" as="geometry" /></mxCell>

        <!-- ============ CABANG F: HANDOVER BELUM DITERIMA (x=150) ============ -->
        <mxCell id="n26" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + OPERATIONAL OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mengklarifikasi ownership, controlled package, training, master data, open action, dan acceptance requirement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="45" y="1126" width="210" height="53" as="geometry" /></mxCell>
        <mxCell id="n27" value="Apakah acceptance dapat diselesaikan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="1209" width="160" height="53" as="geometry" /></mxCell>
        <mxCell id="n28" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;PROJECT OFFICER + RnD MANAGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menahan handover, mencatat open action, dan melakukan eskalasi ownership" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="45" y="1291" width="210" height="53" as="geometry" /></mxCell>
        <mxCell id="n29" value="SELESAI — HANDOVER DITAHAN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="45" y="1372" width="210" height="31" as="geometry" /></mxCell>

        <!-- ============ CABANG READINESS (kanan, x=850 & x=1100) ============ -->
        <mxCell id="n30" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;ACTION OWNER + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mengklasifikasikan gap, menetapkan owner, tindakan, evidence, criticality, dan jalur penyelesaian" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="740" y="574" width="220" height="53" as="geometry" /></mxCell>
        <mxCell id="n31" value="Apakah gap kritis atau perlu kembali ke proses sebelumnya?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="768" y="656" width="165" height="53" as="geometry" /></mxCell>
        <mxCell id="n32" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Membuat Return/Corrective Action Record dan mengembalikan ke Documentation, Trial, Development, Change Control, atau CAPA" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="739" width="180" height="53" as="geometry" /></mxCell>
        <mxCell id="n33" value="SELESAI — RETURN / CORRECTIVE ACTION" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1005" y="820" width="190" height="31" as="geometry" /></mxCell>
        <mxCell id="n34" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;ACTION OWNER + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menutup gap dengan evidence atau menetapkan open action beserta owner, condition, contingency, dan due reference" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="740" y="739" width="220" height="53" as="geometry" /></mxCell>
        <mxCell id="n35" value="Apakah seluruh gap ditutup sebelum release?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="768" y="821" width="165" height="53" as="geometry" /></mxCell>
