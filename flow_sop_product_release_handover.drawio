        <mxCell id="n37" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD MANAGER + PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menahan release dan menyelesaikan critical/open requirement sebelum review ulang" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="1010" y="904" width="180" height="53" as="geometry" /></mxCell>
