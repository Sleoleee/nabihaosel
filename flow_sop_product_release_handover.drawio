        <mxCell id="n41" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;AUTHORIZED APPROVER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mencatat Conditional Release Record dan kondisi yang wajib dimonitor" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="1151" width="220" height="53" as="geometry" /></mxCell>
