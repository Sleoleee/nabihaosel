        <mxCell id="n39" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD MANAGER + QA + PROCESS OWNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menilai scope, condition, residual risk, owner, due reference, monitoring, contingency, dan withdrawal criteria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=7;" vertex="1" parent="1"><mxGeometry x="740" y="986" width="220" height="53" as="geometry" /></mxCell>
