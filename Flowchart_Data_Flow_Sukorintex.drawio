<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0"><diagram id="dataflow-sukorintex" name="Alur Data Sukorintex"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="2880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flowchart Sistem Alur Data - PT Sukorintex" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="1060" height="46" as="geometry"/></mxCell><mxCell id="subtitle" value="Data Flow Analysis: alur data yang dibutuhkan di setiap proses produksi &amp; langkah untuk memperolehnya (10-12 Agustus 2026)" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="80" y="76" width="1060" height="40" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Keterangan simbol &amp; status ketersediaan data:&lt;/b&gt;&lt;br&gt;&amp;#9644; Persegi = Proses/kegiatan &amp;#160;&amp;#160;|&amp;#160;&amp;#160; &amp;#9649; Jajar genjang = Data yang dibutuhkan &amp;#160;&amp;#160;|&amp;#160;&amp;#160; &amp;#11042; Belah ketupat = Keputusan &amp;#160;&amp;#160;|&amp;#160;&amp;#160; &amp;#11053; Oval = Mulai/Selesai&lt;br&gt;🟢 &lt;b&gt;Lengkap&lt;/b&gt; (data siap dipakai) &amp;#160;&amp;#160;|&amp;#160;&amp;#160; 🟡 &lt;b&gt;Sebagian&lt;/b&gt; (ada, perlu dilengkapi) &amp;#160;&amp;#160;|&amp;#160;&amp;#160; 🔴 &lt;b&gt;Belum ada&lt;/b&gt; (perlu dikumpulkan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="80" y="128" width="1060" height="92" as="geometry"/></mxCell><mxCell id="hA" value="ALUR PROSES" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="80" y="214" width="250" height="30" as="geometry"/></mxCell><mxCell id="hB" value="DATA YANG DIBUTUHKAN" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="400" y="214" width="300" height="30" as="geometry"/></mxCell><mxCell id="hC" value="KETERSEDIAAN &amp; CARA MEMPEROLEH" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="760" y="214" width="380" height="30" as="geometry"/></mxCell><mxCell id="start" value="MULAI&lt;br&gt;Permintaan / kebutuhan produksi diterima" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="250" height="60" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;PPIC merencanakan&lt;br&gt;kebutuhan produksi &amp; material&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Menerjemahkan permintaan produksi menjadi kebutuhan material dan jadwal pengadaan.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="250" height="100" as="geometry"/></mxCell><mxCell id="s1_d" value="• Demand produksi dari divisi terkait&lt;br&gt;• Kebutuhan material&lt;br&gt;• Jadwal kebutuhan material" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="416.0" width="300" height="88" as="geometry"/></mxCell><mxCell id="s1_s" value="&lt;b&gt;🔴 Status: BELUM ADA&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Belum ada dokumen khusus.&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; Breakdown kebutuhan material per produksi &amp; jadwal pengadaan dari vendor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="410.0" width="380" height="100" as="geometry"/></mxCell><mxCell id="s1_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s1" target="s1_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1_e2" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;endSize=6;" edge="1" parent="1" source="s1_d" target="s1_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Purchasing memenuhi&lt;br&gt;kebutuhan material&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Menilai kemampuan memenuhi kebutuhan sesuai jumlah, prioritas, dan jadwal.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="250" height="100" as="geometry"/></mxCell><mxCell id="s2_d" value="• Kebutuhan material prioritas&lt;br&gt;• Ketersediaan pemasok&lt;br&gt;• Estimasi waktu pemenuhan" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="626.0" width="300" height="88" as="geometry"/></mxCell><mxCell id="s2_s" value="&lt;b&gt;🔴 Status: BELUM ADA&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Belum ada dokumen sama sekali.&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; Data PO, daftar vendor/supplier, estimasi lead time pengiriman." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="620.0" width="380" height="100" as="geometry"/></mxCell><mxCell id="s2_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s2" target="s2_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e2" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;endSize=6;" edge="1" parent="1" source="s2_d" target="s2_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Gudang menyediakan &amp;&lt;br&gt;mengecek stok material&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Memastikan stok mampu mendukung rencana tanpa overstock / shortage.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="830" width="250" height="100" as="geometry"/></mxCell><mxCell id="s3_d" value="• Stok material tersedia&lt;br&gt;• Kebutuhan material produksi&lt;br&gt;• Potensi kurang / lebih stok" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="836.0" width="300" height="88" as="geometry"/></mxCell><mxCell id="s3_s" value="&lt;b&gt;🟡 Status: SEBAGIAN&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Stok material Printing (Kimia &amp; Pasta).&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; Ketersediaan material utama (benang baku) &amp; sparepart pabrik." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="830.0" width="380" height="100" as="geometry"/></mxCell><mxCell id="s3_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s3" target="s3_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3_e2" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;endSize=6;" edge="1" parent="1" source="s3_d" target="s3_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;PPIC-Purchasing-Gudang&lt;br&gt;menyelaraskan informasi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Memastikan seluruh divisi memakai info kebutuhan &amp; ketersediaan yang sama.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="1040" width="250" height="100" as="geometry"/></mxCell><mxCell id="s4_d" value="• Demand material&lt;br&gt;• Ketersediaan stok&lt;br&gt;• Status pemenuhan kebutuhan" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="1046.0" width="300" height="88" as="geometry"/></mxCell><mxCell id="s4_s" value="&lt;b&gt;🔴 Status: BELUM ADA&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Belum ada.&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; Dashboard / notulensi / laporan gabungan sinkronisasi 3 divisi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="1040.0" width="380" height="100" as="geometry"/></mxCell><mxCell id="s4_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s4" target="s4_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s4_e2" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;endSize=6;" edge="1" parent="1" source="s4_d" target="s4_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dec" value="Material &amp; informasi&lt;br&gt;siap untuk produksi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="95" y="1250" width="220" height="90" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;Menjalankan&lt;br&gt;Proses Persiapan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Menilai kesesuaian material dengan target &amp; hasil produksi Persiapan.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="1460" width="250" height="100" as="geometry"/></mxCell><mxCell id="s5_d" value="• Target / demand proses berikutnya&lt;br&gt;• Ketersediaan material&lt;br&gt;• Realisasi hasil &amp; defect/waste&lt;br&gt;• Biaya perbaikan &amp; sparepart&lt;br&gt;• Laporan utilisasi mesin" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="1448.0" width="300" height="124" as="geometry"/></mxCell><mxCell id="s5_s" value="&lt;b&gt;🟡 Status: SEBAGIAN&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Spesifikasi mesin &amp; estimasi kapasitas.&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; Laporan realisasi defect/waste, pemakaian sparepart, OEE mesin aktual." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="1448.0" width="380" height="124" as="geometry"/></mxCell><mxCell id="s5_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s5" target="s5_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s5_e2" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;endSize=6;" edge="1" parent="1" source="s5_d" target="s5_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;Menjalankan&lt;br&gt;Proses Weaving (Penenunan)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Memahami apakah kapasitas Weaving memenuhi kebutuhan proses selanjutnya.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="1670" width="250" height="100" as="geometry"/></mxCell><mxCell id="s6_d" value="• Target / demand proses berikutnya&lt;br&gt;• Ketersediaan material&lt;br&gt;• Realisasi hasil &amp; defect/waste&lt;br&gt;• Biaya perbaikan &amp; sparepart&lt;br&gt;• Laporan utilisasi mesin" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="1658.0" width="300" height="124" as="geometry"/></mxCell><mxCell id="s6_s" value="&lt;b&gt;🟡 Status: SEBAGIAN&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Komparasi target vs aktual Weaving.&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; OEE mesin rinci, data waste benang, rekap biaya perbaikan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="1658.0" width="380" height="124" as="geometry"/></mxCell><mxCell id="s6_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s6" target="s6_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s6_e2" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;endSize=6;" edge="1" parent="1" source="s6_d" target="s6_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;Menjalankan&lt;br&gt;Proses Printing (Pencetakan)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Menilai kemampuan Printing memenuhi produksi dengan kualitas sesuai.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="1880" width="250" height="100" as="geometry"/></mxCell><mxCell id="s7_d" value="• Target / demand proses berikutnya&lt;br&gt;• Ketersediaan material&lt;br&gt;• Realisasi hasil &amp; defect/waste&lt;br&gt;• Biaya perbaikan &amp; sparepart&lt;br&gt;• Laporan utilisasi mesin" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="1868.0" width="300" height="124" as="geometry"/></mxCell><mxCell id="s7_s" value="&lt;b&gt;🟡 Status: SEBAGIAN&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Target harian &amp; parameter operasional mesin cetak.&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; Laporan defect cetak, downtime aktual, pemakaian sparepart per mesin." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="1868.0" width="380" height="124" as="geometry"/></mxCell><mxCell id="s7_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s7" target="s7_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7_e2" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;endSize=6;" edge="1" parent="1" source="s7_d" target="s7_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;Menjalankan&lt;br&gt;Proses Finishing-Grey&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Menilai kemampuan Finishing memenuhi kebutuhan Packaging (jumlah &amp; kualitas).&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="2090" width="250" height="100" as="geometry"/></mxCell><mxCell id="s8_d" value="• Target / demand proses berikutnya&lt;br&gt;• Ketersediaan material&lt;br&gt;• Realisasi hasil &amp; defect/waste&lt;br&gt;• Biaya perbaikan &amp; sparepart&lt;br&gt;• Laporan utilisasi mesin" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="2078.0" width="300" height="124" as="geometry"/></mxCell><mxCell id="s8_s" value="&lt;b&gt;🟢 Status: LENGKAP&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Sangat lengkap: target kapasitas, OEE (Stenter, Bakar Bulu, Calender, Steamer), lembar pengawasan Karu.&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; Detail tagihan perbaikan/sparepart secara finansial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="2078.0" width="380" height="124" as="geometry"/></mxCell><mxCell id="s8_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s8" target="s8_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s8_e2" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;endSize=6;" edge="1" parent="1" source="s8_d" target="s8_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;Menjalankan&lt;br&gt;Proses Packaging (Pengemasan)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444;&quot;&gt;&lt;i&gt;Tujuan: Menilai apakah kapasitas Packaging memenuhi kebutuhan barang jadi.&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="2300" width="250" height="100" as="geometry"/></mxCell><mxCell id="s9_d" value="• Demand barang jadi&lt;br&gt;• Kapasitas pengemasan&lt;br&gt;• Realisasi barang dikemas" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="2306.0" width="300" height="88" as="geometry"/></mxCell><mxCell id="s9_s" value="&lt;b&gt;🟢 Status: LENGKAP&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data tersedia:&lt;/b&gt; Sangat lengkap: produksi per shift, downtime mesin inspect, grade kualitas, kalkulasi affal.&lt;br&gt;&lt;b&gt;Perlu dikumpulkan:&lt;/b&gt; Hampir tidak ada kekurangan signifikan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="2300.0" width="380" height="100" as="geometry"/></mxCell><mxCell id="s9_e1" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;endSize=6;" edge="1" parent="1" source="s9" target="s9_d"><mxGeometry relative="1" as="geometry"/>