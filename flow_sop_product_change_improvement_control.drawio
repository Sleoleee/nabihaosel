        <mxCell id="cV1" value="V" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="858" y="707" width="22" height="22" as="geometry" /></mxCell>
