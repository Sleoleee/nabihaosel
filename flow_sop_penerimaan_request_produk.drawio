        <!-- No branch 3 -->
        <mxCell id="n3a" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD MANAGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Revisi scope, On Hold, atau Rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="990" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- 7. Project ID -->
        <mxCell id="b7" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Membuat Project ID, menunjuk PIC, dan memasukkan ke project register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E1;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
