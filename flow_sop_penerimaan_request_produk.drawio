<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="sop-request-produk" name="SOP Penerimaan Request Produk">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="FLOW SOP PENERIMAAN REQUEST PRODUK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D71920;strokeColor=#D71920;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="770" height="46" as="geometry" />
        </mxCell>

        <!-- LEGEND -->
        <mxCell id="legend" value="&lt;b&gt;Status akhir:&lt;/b&gt;&lt;br&gt;Approved / Approved with Conditions&lt;br&gt;On Hold / Rejected / Need Clarification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- 1. REQUESTOR -->
        <mxCell id="b1" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;REQUESTOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Requestor mengirim Product Request Form dan dokumen pendukung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F0FA;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="270" height="60" as="geometry" />
        </mxCell>

        <!-- 2. RnD SUPPORT -->
        <mxCell id="b2" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD SUPPORT B2B/B2C&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mencatat request, membuat Request ID, dan mengirim acknowledgement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E8;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="200" width="270" height="60" as="geometry" />
        </mxCell>

        <!-- 3. RnD PROJECT OFFICER -->
        <mxCell id="b3" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memeriksa kelengkapan administratif dan minimum brief" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E8;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="300" width="270" height="60" as="geometry" />
        </mxCell>

        <!-- DECISION 1: Data lengkap? -->
        <mxCell id="d1" value="Data lengkap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="335" y="400" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- No branch box A -->
        <mxCell id="n1a" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;REQUESTOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Dikembalikan untuk klarifikasi / kelengkapan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- No branch box B -->
        <mxCell id="n1b" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Request berstatus Need Clarification; dapat ditutup bila melewati batas waktu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="520" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- 4. Klasifikasi -->
        <mxCell id="b4" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mengklasifikasikan jenis request dan jalur proses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F0FA;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="530" width="270" height="60" as="geometry" />
        </mxCell>

        <!-- 5. TIM REVIEW -->
        <mxCell id="b5" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;TIM REVIEW&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Review feasibility lintas fungsi: bisnis, formula, proses, material, kualitas, biaya, kapasitas, dan lead time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="630" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- DECISION 2: Layak diproses? -->
        <mxCell id="d2" value="Layak diproses?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="335" y="740" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- No branch 2 box A -->
        <mxCell id="n2a" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;TIM REVIEW&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Usulan status: Rejected atau On Hold beserta alasan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="750" width="220" height="70" as="geometry" />
