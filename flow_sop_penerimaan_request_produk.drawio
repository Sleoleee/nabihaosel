        <!-- No branch 2 box B -->
        <mxCell id="n2b" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;DECISION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;RnD Manager mengesahkan keputusan dan Project Officer memberi notifikasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E8;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="860" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- 6. Prioritas -->
        <mxCell id="b6" value="&lt;font color=&quot;#D71920&quot;&gt;&lt;b&gt;RnD PROJECT OFFICER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Menetapkan prioritas, scope awal, target waktu, dan kebutuhan resource" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F0FA;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="870" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- DECISION 3: Disetujui RnD Manager? -->
        <mxCell id="d3" value="Disetujui RnD Manager?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
